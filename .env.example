# Copy to .env and fill in. Never commit .env.
TABPFN_API_KEY=            # from platform.priorlabs.ai (free non-commercial licence)
TELEGRAM_BOT_TOKEN=        # optional: from Telegram's @BotFather
TELEGRAM_OWNER_ID=         # optional: send /start to your bot and it replies with your id
# MORNING_AT=08:00         # optional: time of the daily Telegram summary
# DEMO_DAY=2017-02-01      # optional: the demo motel's fixed day
# PAGE_URL=http://localhost:8000
# DRAFTS=browser           # optional: write messages with Gemma in the browser (WebGPU) instead of Ollama
# HOSTED=1                 # the hosted demo: everything from results/demo_snapshot.json, one desk per visitor
